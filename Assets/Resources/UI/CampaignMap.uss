.campaign-root {
    flex-grow: 1;
    padding: 24px;
    align-items: center;
    justify-content: center;
    color: rgb(230, 225, 210);
}

.campaign-root Label, .campaign-root Button {
    color: rgb(230, 225, 210);
}

.panel {
    background-color: rgba(20, 20, 24, 0.92);
    border-radius: 8px;
    padding: 16px;
    width: 720px;
    max-width: 90%;
}

.title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 230, 210);
    margin-bottom: 8px;
}

.blurb {
    color: rgb(190, 190, 190);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 4px;
}

.meta-line {
    color: rgb(150, 150, 150);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 8px;
}

.location-row {
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
}

.action-button {
    height: 34px;
    margin-bottom: 4px;
    background-color: rgb(70, 60, 40);
    color: rgb(240, 230, 210);
    border-radius: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 8px;
}

.action-button:hover {
    background-color: rgb(95, 82, 55);
}

.action-button:disabled {
    opacity: 0.4;
}

.secondary-button {
    height: 28px;
    margin-top: 8px;
    background-color: rgb(50, 50, 55);
    color: rgb(220, 220, 220);
    border-radius: 4px;
}

.secondary-button:hover {
    background-color: rgb(70, 70, 75);
}

.scroll-view {
    max-height: 640px;
    width: 100%;
}

.traffic-track {
    height: 6px;
    width: 120px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    margin-bottom: 4px;
    overflow: hidden;
}

.traffic-fill {
    height: 100%;
    background-color: rgb(200, 90, 60);
}

.event-image {
    width: 100%;
    height: 220px;
    background-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 12px;
    border-radius: 6px;
}

.tooltip {
    position: absolute;
    background-color: rgba(10, 10, 12, 0.96);
    border-radius: 4px;
    padding: 8px;
    max-width: 320px;
}

.tooltip Label {
    white-space: normal;
    font-size: 12px;
    color: rgb(230, 225, 210);
}
