  m_Name: Ambush Interview
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 0804a843b416f4f408c84fd3f814b036
  _displayName: Ambush Interview
  _blurb: "A reporter corners you off-script."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 45
  _district: {fileID: 11400000, guid: 0fc98ecb448e466193b74300314db188, type: 2}
  _openingMinute: 540
  _closingMinute: 840
  _dropWeight: 1
  _body: "She was waiting by your car with the camera already rolling. No press office, no talking points, just a microphone and a question about your campaign funding you were not ready for."
  _options:
  - _label: "Improvise"
    _resultText: "You say the first honest thing that comes to mind. Whether that was a good idea depends on the edit."
    _requirements: []
    _outcomes:
    - rid: 1
  - _label: "No comment"
    _resultText: "Two words, repeated until she gives up. It makes a dull clip, which is the best kind."
    _requirements: []
    _outcomes: []
  - _label: "Turn it into a stunt"
    _resultText: "You grab the microphone and invite the whole street to ask you anything. The street accepts."
    _requirements: []
    _outcomes:
    - rid: 4
