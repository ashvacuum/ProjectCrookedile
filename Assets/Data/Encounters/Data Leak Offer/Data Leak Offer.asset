  m_Name: Data Leak Offer
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: f416547b42f86c366d5eabfabe6eb4fd
  _displayName: Data Leak Offer
  _blurb: "A hacker offers you your rival's opposition research."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 45
  _district: {fileID: 11400000, guid: 953c76c063bd23d4f852ccff3d65ef38, type: 2}
  _openingMinute: 600
  _closingMinute: 900
  _dropWeight: 1
  _body: "An anonymous account sends you a link: your rival's internal polling and opposition research, scraped from a careless staffer's cloud drive. The hacker wants nothing, which is what worries you."
  _options:
  - _label: "Accept"
    _resultText: "You download it and read it twice. Most of it is noise; some of it will be very useful."
    _requirements: []
    _outcomes:
    - rid: 1
  - _label: "Decline"
    _resultText: "You delete the message and have your laptop checked. Some doors are better left shut."
    _requirements: []
    _outcomes: []
