  m_Name: Merienda Invitation
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 29c370e844b4f6982a01dedabf589da5
  _displayName: Merienda Invitation
  _blurb: "Aling Corazon has invited you to merienda."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 30
  _district: {fileID: 11400000, guid: b255cbc01a87415c883d377da23e2407, type: 2}
  _openingMinute: 780
  _closingMinute: 960
  _dropWeight: 1
  _body: "Aling Corazon runs the barangay's gossip the way other people run a business. She has invited you to merienda at her house. Half the street will be there, and every one of them reports to her."
  _options:
  - _label: "Go, and bring pasalubong"
    _resultText: "You arrive with a box of ensaymada. She accepts it without looking at it and seats you between her two nephews."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
    - rid: 3
  - _label: "Go empty-handed"
    _resultText: "She notices. Everyone notices her noticing."
    _requirements: []
    _outcomes:
    - rid: 3
  - _label: "Send your regrets"
    _resultText: "By dinner the whole barangay knows you were too busy for Aling Corazon."
    _requirements: []
    _outcomes:
    - rid: 4
