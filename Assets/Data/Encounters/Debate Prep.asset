  m_Name: Debate Prep
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 4a6dcc66ed3747441bc1d3ec6e301606
  _displayName: Pop Quiz Debate Prep
  _blurb: "A staffer drills you on policy before the next appearance."
  _image: {fileID: 0}
  _hourCost: 1
  _extraMinutes: 30
  _district: {fileID: 11400000, guid: f92e8d6aa6b14629b92da64d357b2512, type: 2}
  _openingMinute: 480
  _closingMinute: 840
  _dropWeight: 1
  _body: "Your policy staffer has turned the conference room into a debate stage: a podium made of banker's boxes and a list of forty questions your opponent might ask."
  _options:
  - _label: "Study hard"
    _resultText: "Three hours on the housing plan until you can recite it backwards. One of your policy lines gets noticeably sharper."
    _requirements: []
    _outcomes:
    - rid: 1
  - _label: "Wing it"
    _resultText: "You skim the list, decide you know this stuff and go to lunch. Probably fine."
    _requirements: []
    _outcomes: []
  - _label: "Pay a ghostwriter"
    _resultText: "A former senator's speechwriter sends over a page by morning. It is better than anything you have written."
    _requirements: []
    _outcomes:
    - rid: 2
    - rid: 3
