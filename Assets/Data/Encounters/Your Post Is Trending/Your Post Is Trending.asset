  m_Script: {fileID: 11500000, guid: 96fc0531e77308c4db623b06b57f6222, type: 3}
  m_Name: Your Post Is Trending
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 7a0736b56bb31e8b823b2fcdd3f73ea7
  _displayName: Your Post Is Trending
  _blurb: "Something you posted three years ago is back."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 30
  _district: {fileID: 11400000, guid: f92e8d6aa6b14629b92da64d357b2512, type: 2}
  _openingMinute: 480
  _closingMinute: 960
  _dropWeight: 1
  _body: "A joke you posted three years ago is trending, and not in a good way. Your social media volunteer turns her laptop around: four thousand replies and counting. She asks what you want to do."
  _options:
  - _label: "Reply to everyone"
    _resultText: "You start answering. The replies start answering back, faster than you can type."
    _requirements: []
    _outcomes:
    - rid: 1
  - _label: "Delete the post"
    _resultText: "It is gone in a second. The screenshots of it are not, and now there is a second story about the deleting."
    _requirements: []
    _outcomes:
    - rid: 2
  - _label: "Log off for the day"
    _resultText: "You hand your phone to an aide and go for a long walk. The afternoon is gone, but so is most of the outrage."
    _requirements: []
    _outcomes:
    - rid: 3
  references:
    version: 2
    RefIds:
    - rid: 1
      type: {class: GoToEncounterOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
