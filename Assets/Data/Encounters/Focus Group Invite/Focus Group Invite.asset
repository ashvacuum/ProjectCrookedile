  m_Script: {fileID: 11500000, guid: 96fc0531e77308c4db623b06b57f6222, type: 3}
  m_Name: Focus Group Invite
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 593f92f49e5b03e67738146f270db4c8
  _displayName: Focus Group Invite
  _blurb: "A pollster wants to test your message before the real fight."
  _image: {fileID: 0}
  _hourCost: 1
  _extraMinutes: 0
  _district: {fileID: 11400000, guid: 953c76c063bd23d4f852ccff3d65ef38, type: 2}
  _openingMinute: 600
  _closingMinute: 900
  _dropWeight: 1
  _body: "A polling firm has booked a conference room above a bank: twelve undecided voters and a one-way mirror. They want you behind the glass while they test your message."
  _options:
  - _label: "Participate honestly"
    _resultText: "You watch twelve strangers pick your speech apart and learn exactly which lines land. The next crowd will find you easier to like."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
  - _label: "Feed them fake talking points"
    _resultText: "You test a message you would never actually run. One of the fake lines tests better than your real ones. You keep it."
    _requirements: []
    _outcomes:
    - rid: 3
  - _label: "Skip it"
    _resultText: "You send your regrets and an aide. The pollster bills you anyway."
    _requirements: []
    _outcomes: []
  references:
    version: 2
    RefIds:
    - rid: 1
      type: {class: NextBattleHostilityOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
        _amount: -1
    - rid: 2
      type: {class: SetFlagOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
        _flag: focus_group_honest
        _clear: 0
