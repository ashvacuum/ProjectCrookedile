  m_Script: {fileID: 11500000, guid: 96fc0531e77308c4db623b06b57f6222, type: 3}
  m_Name: Volunteer Burnout
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 39c307243918a9cfe8f70f449a8954dc
  _displayName: Volunteer Burnout
  _blurb: "Your team is running on empty."
  _image: {fileID: 0}
  _hourCost: 1
  _extraMinutes: 0
  _district: {fileID: 11400000, guid: f92e8d6aa6b14629b92da64d357b2512, type: 2}
  _openingMinute: 480
  _closingMinute: 900
  _dropWeight: 1
  _body: "Half your volunteers called in sick. The other half are asleep on the office floor next to boxes of unfolded flyers. The campaign is running on instant coffee and spite."
  _options:
  - _label: "Rally them"
    _resultText: "You cut everything that is not working and give each of them one clear job. The campaign gets smaller and sharper."
    _requirements: []
    _outcomes:
    - rid: 1
  - _label: "Let them rest"
    _resultText: "You send everyone home and fold flyers yourself until dark. It costs you the afternoon; they come back tomorrow."
    _requirements: []
    _outcomes:
    - rid: 2
  - _label: "Push through anyway"
    _resultText: "You keep them going on pancit and promises. The work gets done, and a volunteer posts a very honest thread about it."
    _requirements: []
    _outcomes:
    - rid: 3
    - rid: 4
  references:
    version: 2
    RefIds:
