  m_Script: {fileID: 11500000, guid: 96fc0531e77308c4db623b06b57f6222, type: 3}
  m_Name: Photo Op
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: e2ec5572cd3174348a0c1b5697be2b9c
  _displayName: The Photo-Op
  _blurb: "A morning market appearance, with cameras waiting by the plaza."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 45
  _district: {fileID: 11400000, guid: d1be5f821475418c99c6c6335f0ba084, type: 2}
  _openingMinute: 540
  _closingMinute: 780
  _dropWeight: 1
  _body: "The market association has put up a tarp, a borrowed sound system and forty plastic chairs by the plaza fountain. A girl in a pageant sash hands you the microphone and asks what you will do about the flooding on Mabini Street."
  _options:
  - _label: "Give a real answer"
    _resultText: "You talk drainage budgets for four minutes. Half the crowd drifts off to the fish stalls. The half that stays will remember your name."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
  - _label: "Dodge with a soundbite"
    _resultText: "Every street deserves a future, you tell them. It means nothing and it gets applause. You file the line away."
    _requirements: []
    _outcomes:
    - rid: 3
  - _label: "Walk away"
    _resultText: "You plead another engagement and slip out behind the stage. Nobody takes a photo, which is the point."
    _requirements: []
    _outcomes:
    - rid: 4
  references:
    version: 2
    RefIds:
    - rid: 1
      type: {class: AdjustCredibilityOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
        _amount: 5
    - rid: 2
      type: {class: SetFlagOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
        _flag: real_answer
        _clear: 0
    - rid: 3
      type: {class: GainRandomCardOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
