  m_Name: Town Hall Ambush
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 1cc879473b7d054ac3d98c71e8e04597
  _displayName: Town Hall Ambush
  _blurb: "A hostile crowd shows up uninvited."
  _image: {fileID: 0}
  _hourCost: 1
  _extraMinutes: 0
  _district: {fileID: 11400000, guid: 0fc98ecb448e466193b74300314db188, type: 2}
  _openingMinute: 780
  _closingMinute: 960
  _dropWeight: 1
  _body: "Your town hall at the municipal gym was meant to be friendly. Then two busloads of your opponent's supporters arrived with printed signs and a man with a megaphone."
  _options:
  - _label: "Face them"
    _resultText: "You walk out to the podium anyway. The megaphone goes quiet for exactly one second."
    _requirements: []
    _outcomes:
    - rid: 1
  - _label: "Cancel the event"
    _resultText: "You call it off for security reasons. The footage of the empty gym is all anyone shares."
    _requirements: []
    _outcomes:
    - rid: 2
  - _label: "Send a surrogate"
    _resultText: "You pay a popular radio host to take the stage for you. He is good. He is also expensive."
    _requirements: []
    _outcomes:
    - rid: 3
