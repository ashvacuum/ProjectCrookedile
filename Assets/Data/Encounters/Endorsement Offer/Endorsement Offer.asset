  m_Script: {fileID: 11500000, guid: 96fc0531e77308c4db623b06b57f6222, type: 3}
  m_Name: Endorsement Offer
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: d7db8fec09e8369438228f0e0d6a3508
  _displayName: Endorsement Offer
  _blurb: "A controversial figure offers a public endorsement."
  _image: {fileID: 0}
  _hourCost: 1
  _extraMinutes: 15
  _district: {fileID: 11400000, guid: 953c76c063bd23d4f852ccff3d65ef38, type: 2}
  _openingMinute: 600
  _closingMinute: 840
  _dropWeight: 1
  _body: "Congressman Dela Paz has three corruption cases and a very loyal base. His chief of staff slides a folder across the table: a joint rally, a photo, a handshake. All he asks is that you stand next to him."
  _options:
  - _label: "Accept"
    _resultText: "The photo runs on every front page. His supporters are yours now, and so are his enemies."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
  - _label: "Decline"
    _resultText: "You thank him and leave the folder on the table. The story that you turned him down travels faster than any rally would have."
    _requirements: []
    _outcomes:
    - rid: 3
  - _label: "Accept quietly, deny later"
    _resultText: "His people work your crowds; your spokesperson says you have never met the man. Both of these cannot stay true forever."
    _requirements: []
    _outcomes:
    - rid: 4
    - rid: 5
  references:
    version: 2
