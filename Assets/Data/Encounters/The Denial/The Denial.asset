  m_Name: The Denial
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 5e285ed3e595b7a644e31e73bb4ba54c
  _displayName: The Denial
  _blurb: "A reporter asks you point-blank about the endorsement."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 45
  _district: {fileID: 11400000, guid: 0fc98ecb448e466193b74300314db188, type: 2}
  _openingMinute: 540
  _closingMinute: 900
  _dropWeight: 1
  _body: "Two days from the vote, a reporter catches you on the steps of city hall. Did you or did you not accept the Congressman's help? The cameras are rolling and the steps are very public."
  _options:
  - _label: "Come clean"
    _resultText: "You say yes, you accepted, and you regret hiding it. The reporter looks disappointed; there is no story in an honest answer."
    _requirements: []
    _outcomes: []
  - _label: "Deflect"
    _resultText: "You pivot to the flood relief budget and keep talking until she runs out of tape. The only question is whether the edit is kind."
    _requirements: []
    _outcomes:
    - rid: 1
  references:
    version: 2
    RefIds:
