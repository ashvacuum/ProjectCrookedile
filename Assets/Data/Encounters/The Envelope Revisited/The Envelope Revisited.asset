  _id: 71ec4ccf789c3ab40c3238a3301be794
  _displayName: The Envelope, Revisited
  _blurb: "A reporter has proof of the envelope."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 45
  _district: {fileID: 11400000, guid: 0fc98ecb448e466193b74300314db188, type: 2}
