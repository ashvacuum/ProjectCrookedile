  _closingMinute: 900
  _dropWeight: 1
  _body: "A reporter from the Daily Tribune sends you a photo: your campaign treasurer depositing fifty thousand pesos the day after the envelope arrived. She wants a comment by five."
  _options:
  - _label: "Deny it"
    _resultText: "You say the deposit came from a fundraiser. If she cannot prove otherwise before the vote, it holds."
    _requirements: []
    _outcomes:
    - rid: 1
  - _label: "Confirm and spin it"
    _resultText: "You confirm the donation and call it a supporter's gift, fully declared as of today. It is a bad headline, but only one."
    _requirements: []
    _outcomes:
    - rid: 3
  references:
    version: 2
    RefIds:
