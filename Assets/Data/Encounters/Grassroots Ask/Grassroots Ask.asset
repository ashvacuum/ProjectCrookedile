  m_Name: Grassroots Ask
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: dd652f8abe0221141a0309a988dcbf41
  _displayName: Grassroots Ask
  _blurb: "Spend time with residents in the riverside community."
  _image: {fileID: 0}
  _hourCost: 2
  _extraMinutes: 0
  _district: {fileID: 11400000, guid: a54aa622f1ef40a1935aeae6f25c28e9, type: 2}
  _openingMinute: 540
  _closingMinute: 810
  _dropWeight: 1
  _body: "A women's cooperative by the river needs its water pump fixed before the rainy season. They have made it very clear they are not asking for a speech."
  _options:
  - _label: "Help for real"
    _resultText: "You spend the morning with a plumber and a borrowed jeep. The pump works by noon. Nobody takes a photo, and you do not ask them to."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
  - _label: "Promise vaguely"
    _resultText: "You promise to look into it and take a phone number. They have heard that before."
    _requirements: []
    _outcomes: []
  - _label: "Ignore them"
    _resultText: "You have a schedule to keep. The cooperative watches your car leave."
    _requirements: []
    _outcomes: []
  references:
    version: 2
    RefIds:
    - rid: 1
      type: {class: AdjustCredibilityOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
        _amount: 10
    - rid: 2
      type: {class: AdjustFundsOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
