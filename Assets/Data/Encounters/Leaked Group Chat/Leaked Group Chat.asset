  m_Name: Leaked Group Chat
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 349b59413fc6ee946a98291743c7083a
  _displayName: Leaked Group Chat
  _blurb: "Handle the leaked messages with the team at headquarters."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 45
  _district: {fileID: 11400000, guid: f92e8d6aa6b14629b92da64d357b2512, type: 2}
  _openingMinute: 480
  _closingMinute: 915
  _dropWeight: 1
  _body: "Your aide closes the office door before she shows you her phone. Screenshots from your rival's inner circle: jokes about the voters, a line about kickbacks, and your name next to a word you will not repeat."
  _options:
  - _label: "Leak it"
    _resultText: "The screenshots are everywhere by lunch. So are his people, and they know exactly who sent them."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
    - rid: 3
  - _label: "Sit on it"
    _resultText: "You buy a prepaid phone and keep the screenshots on it. Leverage is worth more unspent."
    _requirements:
    - rid: 10
    _outcomes:
    - rid: 4
    - rid: 5
  - _label: "Report it properly"
    _resultText: "You forward everything to the election commission with a formal cover letter. It will go nowhere, but the reporters like that you did it."
    _requirements: []
    _outcomes:
    - rid: 6
  references:
    version: 2
