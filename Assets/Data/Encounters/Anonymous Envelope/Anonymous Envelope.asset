  m_Script: {fileID: 11500000, guid: 96fc0531e77308c4db623b06b57f6222, type: 3}
  m_Name: Anonymous Envelope
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: 48f44f51a4b890bd1ff70e38ef03cea3
  _displayName: Anonymous Envelope
  _blurb: "Cash under the table, no strings stated."
  _image: {fileID: 0}
  _hourCost: 0
  _extraMinutes: 45
  _district: {fileID: 11400000, guid: 953c76c063bd23d4f852ccff3d65ef38, type: 2}
  _openingMinute: 600
  _closingMinute: 900
  _dropWeight: 1
  _body: "A plain brown envelope is on your chair when you come back from lunch. Inside: fifty thousand pesos in thousand-peso bills and a note that says only, For the campaign."
  _options:
  - _label: "Take it"
    _resultText: "The money goes into the ad budget. Nobody has asked for anything yet."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
  - _label: "Refuse it"
    _resultText: "You have the envelope returned to the front desk, unopened and on the record. Word gets around."
    _requirements: []
    _outcomes:
    - rid: 3
  - _label: "Report it"
    _resultText: "You hand it to the police with a statement and let a reporter photograph the handover. Clean hands make good pictures."
    _requirements: []
    _outcomes:
    - rid: 4
  references:
    version: 2
    RefIds:
    - rid: 1
      type: {class: AdjustFundsOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
        _amount: 50
    - rid: 2
      type: {class: SetFlagOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
