  m_Script: {fileID: 11500000, guid: 96fc0531e77308c4db623b06b57f6222, type: 3}
  m_Name: Barangay Fiesta
  m_EditorClassIdentifier: Crookedile.Runtime::Crookedile.Data.Campaign.EventEncounterData
  _id: c92beca63416c57459334fc844354a97
  _displayName: Barangay Fiesta
  _blurb: "Free food and goodwill in the neighborhood."
  _image: {fileID: 0}
  _hourCost: 5
  _extraMinutes: 0
  _district: {fileID: 11400000, guid: b255cbc01a87415c883d377da23e2407, type: 2}
  _openingMinute: 540
  _closingMinute: 660
  _dropWeight: 1
  _body: "The whole barangay is out for the patron saint: a brass band, lechon on
    every other table and a basketball court turned into a dance floor. Everyone
    wants a picture; nobody wants a speech."
  _options:
  - _label: "Join in and sponsor a table"
    _resultText: "You pay for a table, eat everything offered and dance badly with
      the captain's mother. It is the best day of the campaign."
    _requirements: []
    _outcomes:
    - rid: 1
    - rid: 2
  - _label: "Work the crowd"
    _resultText: "You go table to table with a notebook, and by sundown you have
      heard every complaint in the barangay and one good idea."
    _requirements: []
    _outcomes:
    - rid: 3
  - _label: "Skip it"
    _resultText: "You watch the fireworks from the car. Someone posts a photo of
      you doing it."
    _requirements: []
    _outcomes: []
  references:
    version: 2
    RefIds:
    - rid: 1
      type: {class: AdjustCredibilityOutcome, ns: Crookedile.Data.Campaign, asm: Crookedile.Runtime}
      data:
